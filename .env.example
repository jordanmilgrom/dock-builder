# Postgres connection (Neon in prod; local Postgres in dev/CI).
# Neon example: postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dock_dev"

# Magic-link / session signing secret (HMAC). Override in prod.
AUTH_SECRET="dev-only-insecure-secret-change-in-prod"

# Apex domain for vanity subdomains: {slug}.app.com -> tenant.
# Local dev has no real subdomains; use the ?tenant={slug} query fallback instead.
APP_DOMAIN="app.com"

# Default tenant slug when no subdomain/query is present (local dev, root domain).
DEFAULT_TENANT_SLUG="acme-docks"

# Stripe (test keys). Never commit live keys. Webhook secret from `stripe listen`.
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price IDs per tier (from your Stripe dashboard / fixtures).
STRIPE_PRICE_STARTER="price_starter_xxx"
STRIPE_PRICE_PRO="price_pro_xxx"
STRIPE_PRICE_PREMIUM="price_premium_xxx"
