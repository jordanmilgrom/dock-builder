{
  "name": "dock-configurator-engines",
  "version": "0.1.0",
  "private": true,
  "description": "Headless, fully-tested engines for the Dock Configurator SaaS (Phase 0): validation, pricing, and geometry/derived-metrics over a single dock-config JSON.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "typecheck:engine": "tsc -p tsconfig.engine.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "NODE_OPTIONS=--conditions=react-server tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.35",
    "pdfkit": "^0.15.2",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0"
  }
}
