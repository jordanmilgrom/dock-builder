// Dock Configurator SaaS — Phase 2 persistence (multi-tenant).
//
// Every tenant-owned entity carries `tenantId`. The application NEVER queries
// these tables directly — all access goes through `src/lib/tenantScope.ts`,
// which injects `tenantId` into every read/write so one tenant can never touch
// another's rows (proven by lib/tenantScope.test.ts).
//
// Postgres (Neon in prod, local Postgres in dev/CI). JSON columns hold the
// engine's framework-free value objects (DockConfig, PricingResult, etc.) so the
// pure engines in src/engine stay the single source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant + billing
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  starter
  pro
  premium
}

// Stripe-driven lifecycle. `trialing` covers the 14-day free trial.
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

model Tenant {
  id        String   @id // human-readable, e.g. "acme-docks"
  slug      String   @unique // vanity subdomain: {slug}.app.com
  name      String
  createdAt DateTime @default(now())

  // Billing (Stripe is the source of truth; we mirror status + entitlements).
  tier                 SubscriptionTier   @default(starter)
  subscriptionStatus   SubscriptionStatus @default(trialing)
  trialEndsAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique

  // Entitlement booleans derived from the tier (see lib/entitlements.ts).
  // Stored denormalized on the row so the customer flow reads them cheaply.
  entitlements Json
  // Lead cap for the current billing period; null = unlimited (Premium).
  leadCap Int?

  // Phase 3: days of inactivity before a captured-but-unsubmitted lead is
  // DERIVED as abandoned (§10 #7). Per-tenant override, range 1–30.
  abandonedThresholdDays Int @default(3)

  // Phase 4: custom domain (§5.7, gated by entitlements.customDomain). Resolved
  // in middleware by indexed lookup; only honored once verified.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  customDomainTxtToken   String?

  // Phase 5: notification channel config (gated by entitlements).
  slackWebhookUrl    String?
  twilioFromOverride String?

  // Phase 7: when true, the customer flow skips the opt-in questionnaire wizard
  // and lands straight on the empty Canvas editor. Premium-only (gated in the
  // branding editor); additive, defaults false so existing tenants are unchanged.
  skipWizardByDefault Boolean @default(false)

  branding        Branding?
  users           User[]
  customers       Customer[]
  designs         Design[]
  revisions       Revision[]
  leads           Lead[]
  notifications   Notification[]
  pricingProfiles PricingProfile[]
  pricingItems    PricingItem[]
  floatProducts   FloatProduct[]
  deckingProducts DeckingProduct[]
  accessoryProducts AccessoryProduct[]
  templates        Template[]
  events           Event[]
  invitations      Invitation[]
  jobs             Job[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
}

// ---------------------------------------------------------------------------
// Auth (magic-link only; no passwords in Phase 2)
// ---------------------------------------------------------------------------

enum UserRole {
  platform_admin // tenantId null — runs /admin
  builder_admin // tenant owner
  builder_member // tenant staff
}

model User {
  id        String   @id @default(cuid())
  email     String
  role      UserRole
  createdAt DateTime @default(now())

  // platform_admin has no tenant; builder users belong to exactly one.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Branding (§5.2)
// ---------------------------------------------------------------------------

model Branding {
  tenantId       String  @id
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  logoText       String
  logoUrl        String? // uploaded logo (Phase 2 onboarding)
  primaryColor   String
  secondaryColor String
  removeBadge    Boolean @default(false) // tier-gated by entitlements.removeBadge
}

// ---------------------------------------------------------------------------
// Catalog + pricing (§4) — cloned per-tenant from lib/seed.ts at onboarding
// ---------------------------------------------------------------------------

model PricingProfile {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Phase 4: named profile (e.g. a location). The default set carries isDefault.
  name            String        @default("Default")
  isDefault       Boolean       @default(false)
  dockType        String // engine DockType
  priceVisibility String // engine PriceVisibility
  currency        String        @default("USD")
  labor           Json? // { perFt2?, flat? }
  deliveryBands   Json? // DeliveryBand[]
  minimumPrice    Float?
  markupPct       Float?
  items           PricingItem[]
  designs         Design[]

  @@unique([tenantId, name, dockType])
  @@index([tenantId])
  @@index([tenantId, dockType])
}

model PricingItem {
  id        String         @id @default(cuid())
  tenantId  String // denormalized so the scope can filter items directly
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId String
  profile   PricingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  unit      String // engine PricingUnit
  unitPrice Float
  label     String?
  enabled   Boolean        @default(true)

  @@index([profileId])
  @@index([tenantId])
}

model FloatProduct {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku              String
  ratedBuoyancyLbs Float
  lengthIn         Float
  widthIn          Float
  heightIn         Float
  sealedShell      Boolean @default(true)
  enabled          Boolean @default(true)

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model DeckingProduct {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  material      String // engine DeckingMaterial
  label         String
  upchargePerFt2 Float  @default(0)
  enabled       Boolean @default(true)

  @@unique([tenantId, material])
  @@index([tenantId])
}

model AccessoryProduct {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // engine AccessoryType
  label     String
  unitPrice Float
  enabled   Boolean @default(true)

  @@unique([tenantId, type])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Customer-facing entities (Phase 1 flow, now tenant-scoped)
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String // "" for anonymous until captured
  savedShoreline Json? // SiteConditions
  consent        Json? // Consent
  // Phase 3: builder's free-text CRM notes about this customer (5,000 char cap
  // enforced at the API boundary).
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  designs Design[]
  leads   Lead[]

  @@index([tenantId])
  @@index([tenantId, email])
}

model Design {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  currentRevisionId String   @default("")
  status            String   @default("draft") // draft | submitted
  // Phase 4: optional pricing profile (Premium multi-profile). Null → tenant default.
  pricingProfileId  String?
  pricingProfile    PricingProfile? @relation(fields: [pricingProfileId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  revisions Revision[]
  lead      Lead?

  @@index([tenantId])
  @@index([tenantId, customerId])
}

model Revision {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  designId         String
  design           Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  version          Int
  config           Json // DockConfig (immutable snapshot)
  schemaVersion    Int
  estimateSnapshot Json? // PricingResult, frozen at snapshot time
  authorRole       String // AuthorRole
  authorId         String
  changeSummary    String
  createdAt        DateTime @default(now())

  @@unique([designId, version])
  @@index([tenantId])
  @@index([designId])
}

model Lead {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  designId        String   @unique
  design          Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerContact Json // { email }
  consent         Json
  // §5.4 state machine. The stored value is the persisted state; started→abandoned
  // is DERIVED on read from lastActivityAt + tenant.abandonedThresholdDays.
  status          String   @default("started")
  // Drives the abandoned derivation; bumped on every customer interaction.
  lastActivityAt  DateTime @default(now())
  // Set when the customer submits; also distinguishes started vs submitted on backfill.
  submittedAt     DateTime?
  // The revision the builder last sent as a quote (re-quote updates this; status stays quoted).
  quotedRevisionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job             Job?

  @@index([tenantId])
  @@index([tenantId, status])
}

// Phase 3: builder notifications panel (new-lead + abandoned-lead). Delivery
// (email) is separate (lib/notifications.ts); this row backs the dashboard panel.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // new_lead | abandoned_lead
  leadId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, read])
}

// ---------------------------------------------------------------------------
// Phase 4: starter templates, analytics events, team invitations
// ---------------------------------------------------------------------------

// A saved DockConfig snapshot a customer can "start from" (§5.6). No tier gate.
model Template {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  config    Json // DockConfig snapshot
  createdBy String // builder userId
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Thin analytics event (§5.6). Compute-on-read roll-ups via getDashboardMetrics.
model Event {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind     String // configurator_view | design_started | design_submitted | lead_abandoned | quote_sent | lead_accepted
  at       DateTime @default(now())
  meta     Json?

  @@index([tenantId, kind, at])
}

// Team invitation (§5.6, gated by entitlements.team). Magic-link only.
model Invitation {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole @default(builder_member)
  token      String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Phase 5: job tracking, outbound webhooks
// ---------------------------------------------------------------------------

// §5.4 job phase. A Job is created when a lead is accepted on a tenant with
// entitlements.jobTracking; it is its own state machine joined by leadId.
enum JobStatus {
  in_production
  install_scheduled
  complete
}

model Job {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId     String    @unique
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status     JobStatus @default(in_production)
  milestones Json      @default("[]") // { label, at }[]
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

// Tenant-configured outbound webhook target (§5.9). Gated by entitlements.webhooks.
model WebhookEndpoint {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url                String
  // Signing secret. Symmetric HMAC requires it for signing, so it is stored and
  // shown exactly once at creation — never returned by read APIs.
  secret             String
  eventKinds         String[]
  createdAt          DateTime  @default(now())
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?
  deliveries         WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventKind     String
  payload       Json
  attempt       Int             @default(0)
  status        String          @default("pending") // pending | delivered | failed
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId])
  @@index([status, nextAttemptAt])
}
